# SGR backend
SGR_DATABASE_URL=postgresql+asyncpg://sgr:sgr@localhost:5432/sgr
SGR_PORT=8080
SGR_LOG_LEVEL=INFO
SGR_CORS_ORIGINS=http://localhost:5173

# Auth mode:
#   sinas       — per-user: backend validates the caller's Sinas bearer token
#                 via /auth/me on every request, uses that token for callbacks
#   simplified  — single-key: backend uses SINAS_API_KEY for ALL Sinas
#                 callbacks; the user owning that key is the admin
SGR_AUTH_MODE=simplified

# Sinas instance SGR talks to
SINAS_URL=http://localhost:8000

# Required when SGR_AUTH_MODE=simplified. Resolved once via /auth/me to
# derive the admin user id (no separate owner-id env var needed).
SINAS_API_KEY=

# ── question runs ──────────────────────────────────────────────────────────
# Drafting strategy. "extract" is chatless: an argument plan, then verbatim
# passage extraction verified against the source text, then one drafting call.
# "chat" is the older agent-chat drafting loop.
SGR_DRAFT_MODE=extract

# Hard per-run spend ceiling in USD. A run that crosses it ends "partial" with
# whatever it has verified, rather than running on.
SGR_RUN_COST_CAP_USD=10

# Benchmark fixtures for the retrieval regression harness. Empty = ~/sgr-benchmark.
SGR_BENCH_DIR=

# ── what this deployment holds ─────────────────────────────────────────────
# SGR is domain-neutral. These are the only place a deployment tells
# the models what kind of corpus and reader they are serving; nothing branches
# on them, they change wording only. Leave them unset for generic framing.
#
# Adjective for the corpus domain, e.g. legal, clinical, regulatory.
SGR_DOMAIN=
# Who a client-facing note is written for, e.g. "a legal researcher".
SGR_AUDIENCE=a researcher
